[Unit]
Description=Wolf-OS First Boot Optimization
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/etc/wolf-os/firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/libexec/wolf-os-optimization.sh
RemainAfterExit=yes
Restart=no
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target  
